# The ID shown in Google Calendar's Settings and sharing > Integrate calendar.
GOOGLE_CALENDAR_ID=replace-with-calendar-id@group.calendar.google.com
# Optional local fallback only. In GitHub Actions, use keyless Workload Identity Federation.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me"}
TARGET_ROUTES=J,Z
INCLUDE_REALTIME_ALERTS=false
DRY_RUN=false
LOG_LEVEL=INFO
